FROM python:3.13-slim

ENV PYTHONDONTWRITEBYTECODE=1
ENV PYTHONUNBUFFERED=1
ENV PYTHONPATH=/srv
ENV QOS_ENV=production

WORKDIR /srv

COPY requirements.txt /srv/requirements.txt
RUN pip install --no-cache-dir -r /srv/requirements.txt

# Keep the backend as a real Python package so relative imports such as
# "from .production import ..." work correctly.
COPY . /srv/quantos

EXPOSE 8000

CMD ["sh", "-c", "uvicorn quantos.main:app --host 0.0.0.0 --port ${PORT:-8000}"]
