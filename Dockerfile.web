# Quant OS dashboard: built as a static site and served by nginx.
# The repository keeps the Next.js files flat at the root; this build arranges them into app/ and components/.
FROM node:22-alpine AS build
WORKDIR /build
COPY package.json tsconfig.json next.config.ts ./
RUN npm install --no-audit --no-fund
RUN mkdir -p app components
COPY page.tsx layout.tsx globals.css app/
COPY QuantOS.tsx components/
ARG NEXT_PUBLIC_QUANT_API_URL=https://quantos-api.fly.dev
ARG NEXT_PUBLIC_QUANT_WS_URL=wss://quantos-api.fly.dev/ws/stream
ENV STATIC_EXPORT=true NEXT_TELEMETRY_DISABLED=1 \
    NEXT_PUBLIC_QUANT_API_URL=$NEXT_PUBLIC_QUANT_API_URL NEXT_PUBLIC_QUANT_WS_URL=$NEXT_PUBLIC_QUANT_WS_URL
RUN npx next build

FROM nginx:1.27-alpine
COPY deploy/nginx-web.conf /etc/nginx/conf.d/default.conf
COPY --from=build /build/out /usr/share/nginx/html
EXPOSE 8080
